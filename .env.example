# Firebase – Werte aus der Firebase Console → Projekteinstellungen → Allgemein → Ihre Apps → Web-App
FIREBASE_API_KEY=your_firebase_api_key
FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=your_sender_id
FIREBASE_APP_ID=1:your_project_id:web:your_hash
FIREBASE_MEASUREMENT_ID=G-your_measurement_id

# Google Maps API Key – https://console.cloud.google.com → APIs & Dienste → Anmeldedaten
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Gemini API Key – https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key

# Google Sign-In Web OAuth Client ID – Firebase Console → Authentication → Sign-in method → Google
GOOGLE_WEB_CLIENT_ID=your_project_number-random_hash.apps.googleusercontent.com

# Grok API Key (optional) – https://x.ai/api
GROK_API_KEY=
