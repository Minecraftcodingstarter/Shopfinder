# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nearby_shop_finder

# JWT Secret (generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_SECRET=your-jwt-secret-here-change-in-production

# Firebase Admin SDK – Pfad zum Service-Account-Key (JSON)
# Download: Firebase Console → Projekteinstellungen → Dienstkonten → "Neuen privaten Schlüssel generieren"
GOOGLE_APPLICATION_CREDENTIALS=./firebase-service-account.json

# Firebase Project ID
FIREBASE_PROJECT_ID=shopfinder-5f670

# Google APIs (serverseitig, sicher)
GOOGLE_MAPS_API_KEY=AIzaSyA5HAn_0qhXC7AgHFJWpRvL2qlWBYxPkV8
